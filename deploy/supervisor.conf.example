; Fitness Gym AI — queue worker. Needed only if queued jobs are added: today every
; write happens inside the request. Restart after every release:
;   php artisan queue:restart
; Replace the release path and user.

[program:fitness-gym-ai-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/fitness-gym-ai/current/artisan queue:work --sleep=3 --tries=3 --timeout=90
directory=/var/www/fitness-gym-ai/current
user=www-data
numprocs=1
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=100
redirect_stderr=true
stdout_logfile=/var/www/fitness-gym-ai/shared/storage/logs/worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
